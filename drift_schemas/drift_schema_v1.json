          "sql": "CREATE TABLE IF NOT EXISTS \"modules\" (\"id\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"semester\" INTEGER NULL, \"ue_category\" TEXT NULL, \"academic_year\" TEXT NULL, \"server_version\" INTEGER NOT NULL DEFAULT 0, \"local_version\" INTEGER NOT NULL DEFAULT 0, \"lesson_count\" INTEGER NOT NULL DEFAULT 0, \"lessons_done\" INTEGER NOT NULL DEFAULT 0, \"resource_count\" INTEGER NOT NULL DEFAULT 0, \"languages\" TEXT NOT NULL DEFAULT '', \"downloaded_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
